# Copy to .env.development.local, or inject secrets with your own secret manager.
# Convex CLI writes deployment selection and NEXT_PUBLIC_CONVEX_URL to .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_PASSWORD=
BROADCASTER_SECRET=

# Use your own LiveKit project; the web server and broadcaster must share a room.
LIVEKIT_ROOM=open-livestream-dev
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Read by the local broadcaster only. Never prefix these with NEXT_PUBLIC_.
REACTOR_API_KEY=
REACTOR_MODEL=reactor/fast-h3
REACTOR_API_URL=https://api.reactor.inc
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_TIMEOUT_MS=5000
CLIP_SECONDS=10

# Set OPENAI_API_KEY and the matching BROADCASTER_SECRET in Convex itself.
# OPENAI_API_KEY is required for viewer and final scene moderation, plus Admin AI.
