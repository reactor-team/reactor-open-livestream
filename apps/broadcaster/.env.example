# The local supervisor uses manual mode. Production omits this value and starts
# the bridge immediately.
CONVEX_URL=
BROADCASTER_SECRET=
BROADCASTER_MANUAL=0

# Cerebras plans each submitted scene before it enters FastH3's continuity chain.
# An empty queue on startup waits for creator input; there is no fallback show.
CLIP_SECONDS=10
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=low
CEREBRAS_TIMEOUT_MS=5000
LIVEKIT_ROOM=reactor-tv
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_VIDEO_BITRATE_K=4500

# The deployed Reactor model. Local mode connects to a locally served model
# without minting a hosted token.
REACTOR_MODEL=reactor/fast-h3
REACTOR_API_KEY=
REACTOR_API_URL=https://api.reactor.inc
REACTOR_LOCAL=0
REACTOR_LOCAL_URL=http://localhost:8080

# Railway provides PORT. Keep the health server available in local runs too.
PORT=8787
